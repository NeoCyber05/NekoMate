# Cấu hình máy chủ NekoMate (sao chép thành .env và điền giá trị thật, không commit .env)
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# Tạo bằng: npm run hash-password -- "mat-khau-cua-ban"
OWNER_PASSWORD_HASH=

# SQLite & thiết bị mặc định
DB_PATH=./data/nekomate.db
DEVICE_ID=nekomate-01
TIMEZONE=Asia/Ho_Chi_Minh

# MQTT Broker (Mosquitto)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=nekomate-server
MQTT_PASSWORD=change-me-server-mqtt-password

# Composio
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=nekomate-owner
# Danh sách nguồn đã xác minh với tài khoản thật (phân tách bằng dấu phẩy). Để trống = bật Google Calendar & Todoist mặc định hoặc cấu hình theo kiểm thử.
NEKOMATE_VERIFIED_SOURCES=google_calendar,todoist
