{
  "name": "nekomate-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "esbuild web/dashboard.jsx --bundle --minify --format=esm --jsx=automatic --jsx-import-source=preact --external:/assets/* --loader:.woff2=file --outdir=public/ui --asset-names=fonts/[name]-[hash]",
    "prestart": "npm run build",
    "start": "node src/index.ts",
    "predev": "npm run build",
    "dev": "node --watch src/index.ts",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "hash-password": "node src/hash-password.ts"
  },
  "dependencies": {
    "@composio/core": "^0.6.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mqtt": "^5.10.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "preact": "^11.2.0",
    "typescript": "^5.8.3"
  }
}
